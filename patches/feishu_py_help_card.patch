+    async def _forward_help_to_sidecar(self, event: MessageEvent) -> bool:
+        """Send interactive help card via sidecar /help endpoint. Returns True on success.""'
+        if aiohttp is None:
+            return False
+        chat_id = getattr(event.source, "chat_id", "") if event.source else ""
+        if not chat_id:
+            return False
+        sidecar_url = os.getenv("HERMES_FEISHU_CARD_EVENT_URL", "http://127.0.0.1:8765")
+        help_url = sidecar_url.rsplit("/events", 1)[0] + "/help"
+        try:
+            async with aiohttp.ClientSession() as session:
+                async with session.post(
+                    help_url,
+                    json={"chat_id": chat_id},
+                    timeout=aiohttp.ClientTimeout(total=3),
+                ) as resp:
+                    if resp.status == 200:
+                        body = await resp.json()
+                        if body.get("ok"):
+                            return True
+        except Exception:
+            pass
+        return False
